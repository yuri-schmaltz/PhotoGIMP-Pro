+void
+gimp_display_shell_motion_controller_enter (GtkEventControllerMotion *controller,
+                                            gdouble                   x,
+                                            gdouble                   y,
+                                            GimpDisplayShell         *shell)
+{
+  GimpCoords display_coords = GIMP_COORDS_DEFAULT_VALUES;
+  GimpCoords image_coords;
+
+  g_return_if_fail (GIMP_IS_DISPLAY_SHELL (shell));
+
+  display_coords.x = x;
+  display_coords.y = y;
+  gimp_display_shell_untransform_coords (shell, &display_coords, &image_coords);
+  gimp_display_shell_buffer_hover (shell->motion_buffer, &image_coords, 0, TRUE, shell);
+}
+
+void
+gimp_display_shell_motion_controller_leave (GtkEventControllerMotion *controller,
+                                            GimpDisplayShell         *shell)
+{
+  g_return_if_fail (GIMP_IS_DISPLAY_SHELL (shell));
+}
+
+void
+gimp_display_shell_motion_controller_motion (GtkEventControllerMotion *controller,
+                                             gdouble                   x,
+                                             gdouble                   y,
+                                             GimpDisplayShell         *shell)
+{
+  GimpCoords display_coords = GIMP_COORDS_DEFAULT_VALUES;
+  GimpCoords image_coords;
+
+  g_return_if_fail (GIMP_IS_DISPLAY_SHELL (shell));
+
+  display_coords.x = x;
+  display_coords.y = y;
+  gimp_display_shell_untransform_coords (shell, &display_coords, &image_coords);
+  gimp_display_shell_buffer_hover (shell->motion_buffer, &image_coords, 0, TRUE, shell);
+}
+
+gboolean
+gimp_display_shell_key_controller_key_pressed (GtkEventControllerKey *controller,
+                                               guint                  keyval,
+                                               guint                  keycode,
+                                               GdkModifierType        state,
+                                               GimpDisplayShell      *shell)
+{
+  g_return_val_if_fail (GIMP_IS_DISPLAY_SHELL (shell), FALSE);
+
+  if (keyval == GDK_KEY_space && ! shell->space_release_pending)
+    {
+      gimp_display_shell_space_pressed (shell, NULL);
+      return TRUE;
+    }
+
+  return FALSE;
+}
+
+void
+gimp_display_shell_key_controller_key_released (GtkEventControllerKey *controller,
+                                                guint                  keyval,
+                                                guint                  keycode,
+                                                GdkModifierType        state,
+                                                GimpDisplayShell      *shell)
+{
+  g_return_if_fail (GIMP_IS_DISPLAY_SHELL (shell));
+
+  if (keyval == GDK_KEY_space)
+    {
+      gimp_display_shell_space_released (shell, NULL);
+    }
+}
