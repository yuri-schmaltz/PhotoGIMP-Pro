+void
+gimp_display_shell_snapshot (GtkWidget        *widget,
+                             GtkSnapshot      *snapshot,
+                             GimpDisplayShell *shell)
+{
+  GimpImage       *image;
+  gint             width, height;
+  graphene_rect_t  bounds;
+
+  g_return_if_fail (GIMP_IS_DISPLAY_SHELL (shell));
+  g_return_if_fail (snapshot != NULL);
+
+  if (! shell->display || ! gimp_display_get_shell (shell->display))
+    return;
+
+  width  = gtk_widget_get_width (widget);
+  height = gtk_widget_get_height (widget);
+
+  if (width <= 0 || height <= 0)
+    return;
+
+  graphene_rect_init (&bounds, 0.0f, 0.0f, (float) width, (float) height);
+
+  image = gimp_display_get_image (shell->display);
+
+  /* Render background with GskColorNode / GskRenderNode */
+  {
+    GdkRGBA bg_color = { 0.12f, 0.12f, 0.12f, 1.0f };
+    gtk_snapshot_append_color (snapshot, &bg_color, &bounds);
+  }
+
+  if (! image || gimp_image_get_converting (image))
+    {
+      cairo_t *cr = gtk_snapshot_append_cairo (snapshot, &bounds);
+      if (cr)
+        {
+          gimp_display_shell_draw_background (shell, cr);
+          cairo_destroy (cr);
+        }
+      return;
+    }
+
+  /* GPU-accelerated canvas viewport transformation pipeline */
+  {
+    graphene_matrix_t matrix;
+    graphene_point3d_t p_scale;
+
+    graphene_matrix_init_identity (&matrix);
+    graphene_point3d_init (&p_scale, (float) shell->scale_x, (float) shell->scale_y, 1.0f);
+    graphene_matrix_scale (&matrix, p_scale.x, p_scale.y, p_scale.z);
+
+    if (shell->rotate_angle != 0.0)
+      {
+        graphene_matrix_rotate_z (&matrix, (float) shell->rotate_angle);
+      }
+
+    gtk_snapshot_push_transform (snapshot, gsk_transform_matrix (gsk_transform_new (), &matrix));
+
+    /* If render_cache is present and valid, stream as GdkTexture / GskTextureNode */
+    if (shell->render_cache &&
+        cairo_surface_get_type (shell->render_cache) == CAIRO_SURFACE_TYPE_IMAGE)
+      {
+        GdkTexture      *texture;
+        GBytes          *bytes;
+        gint             surf_w = cairo_image_surface_get_width (shell->render_cache);
+        gint             surf_h = cairo_image_surface_get_height (shell->render_cache);
+        gint             stride = cairo_image_surface_get_stride (shell->render_cache);
+        const guchar    *data   = cairo_image_surface_get_data (shell->render_cache);
+        graphene_rect_t  tex_bounds;
+
+        if (data && surf_w > 0 && surf_h > 0)
+          {
+            bytes = g_bytes_new_static (data, (gsize) stride * surf_h);
+            texture = gdk_memory_texture_new (surf_w, surf_h,
+                                              GDK_MEMORY_B8G8R8A8_PREMULTIPLIED,
+                                              bytes, stride);
+            graphene_rect_init (&tex_bounds, 0.0f, 0.0f, (float) surf_w, (float) surf_h);
+            gtk_snapshot_append_texture (snapshot, texture, &tex_bounds);
+            g_object_unref (texture);
+            g_bytes_unref (bytes);
+          }
+      }
+    else
+      {
+        /* Cairo blit fallback */
+        cairo_t *cr = gtk_snapshot_append_cairo (snapshot, &bounds);
+        if (cr)
+          {
+            gimp_display_shell_draw_checkerboard (shell, cr);
+            gimp_display_shell_draw_image (shell, cr, 0, 0, width, height);
+            cairo_destroy (cr);
+          }
+      }
+
+    gtk_snapshot_pop (snapshot);
+  }
+
+  /* Overlay elements: handles, vector guides, selection marching ants */
+  {
+    cairo_t *cr = gtk_snapshot_append_cairo (snapshot, &bounds);
+    if (cr)
+      {
+        if (shell->canvas_item)
+          gimp_canvas_item_draw (shell->canvas_item, cr);
+        if (shell->unrotated_item)
+          gimp_canvas_item_draw (shell->unrotated_item, cr);
+        if (shell->selection)
+          gimp_display_shell_selection_draw (shell, cr);
+        cairo_destroy (cr);
+      }
+  }
+}
+
