-  gimp_display_shell_rotate_to (shell, constrain ? RINT (angle / 15.0) * 15.0 : angle);
+  if (constrain)
+    {
+      /* 15-degree increment stepping when Ctrl is held */
+      angle = RINT (angle / 15.0) * 15.0;
+    }
+  else
+    {
+      /* Magnetic snapping to cardinal angles (0°, 90°, 180°, 270°) within 3° tolerance */
+      #define CARDINAL_SNAP_TOLERANCE 3.0
+      gdouble norm = fmod (angle, 360.0);
+      if (norm < 0.0)
+        norm += 360.0;
+
+      if (norm < CARDINAL_SNAP_TOLERANCE || norm > (360.0 - CARDINAL_SNAP_TOLERANCE))
+        angle = angle - (norm < 180.0 ? norm : (norm - 360.0));
+      else if (fabs (norm - 90.0) <= CARDINAL_SNAP_TOLERANCE)
+        angle = angle + (90.0 - norm);
+      else if (fabs (norm - 180.0) <= CARDINAL_SNAP_TOLERANCE)
+        angle = angle + (180.0 - norm);
+      else if (fabs (norm - 270.0) <= CARDINAL_SNAP_TOLERANCE)
+        angle = angle + (270.0 - norm);
+    }
+
+  gimp_display_shell_rotate_to (shell, angle);
 }
 
