+void
+gimp_display_shell_tool_events_init (GimpDisplayShell *shell)
+{
+  g_return_if_fail (GIMP_IS_DISPLAY_SHELL (shell));
+  g_return_if_fail (shell->canvas != NULL);
+
+  /* GtkGestureClick */
+  shell->click_gesture = gtk_gesture_click_new ();
+  gtk_event_controller_set_propagation_phase (GTK_EVENT_CONTROLLER (shell->click_gesture),
+                                              GTK_PHASE_BUBBLE);
+  g_signal_connect (shell->click_gesture, "pressed",
+                    G_CALLBACK (gimp_display_shell_click_gesture_pressed),
+                    shell);
+  g_signal_connect (shell->click_gesture, "released",
+                    G_CALLBACK (gimp_display_shell_click_gesture_released),
+                    shell);
+  g_signal_connect (shell->click_gesture, "stopped",
+                    G_CALLBACK (gimp_display_shell_click_gesture_stopped),
+                    shell);
+  gtk_widget_add_controller (GTK_WIDGET (shell->canvas),
+                             GTK_EVENT_CONTROLLER (shell->click_gesture));
+
+  /* GtkGestureDrag */
+  shell->drag_gesture = gtk_gesture_drag_new ();
+  gtk_event_controller_set_propagation_phase (GTK_EVENT_CONTROLLER (shell->drag_gesture),
+                                              GTK_PHASE_BUBBLE);
+  g_signal_connect (shell->drag_gesture, "drag-begin",
+                    G_CALLBACK (gimp_display_shell_drag_gesture_begin),
+                    shell);
+  g_signal_connect (shell->drag_gesture, "drag-update",
+                    G_CALLBACK (gimp_display_shell_drag_gesture_update),
+                    shell);
+  g_signal_connect (shell->drag_gesture, "drag-end",
+                    G_CALLBACK (gimp_display_shell_drag_gesture_end),
+                    shell);
+  gtk_widget_add_controller (GTK_WIDGET (shell->canvas),
+                             GTK_EVENT_CONTROLLER (shell->drag_gesture));
+
+  /* GtkGestureStylus */
+  shell->stylus_gesture = gtk_gesture_stylus_new ();
+  gtk_event_controller_set_propagation_phase (GTK_EVENT_CONTROLLER (shell->stylus_gesture),
+                                              GTK_PHASE_BUBBLE);
+  g_signal_connect (shell->stylus_gesture, "down",
+                    G_CALLBACK (gimp_display_shell_stylus_gesture_down),
+                    shell);
+  g_signal_connect (shell->stylus_gesture, "motion",
+                    G_CALLBACK (gimp_display_shell_stylus_gesture_motion),
+                    shell);
+  g_signal_connect (shell->stylus_gesture, "up",
+                    G_CALLBACK (gimp_display_shell_stylus_gesture_up),
+                    shell);
+  g_signal_connect (shell->stylus_gesture, "proximity",
+                    G_CALLBACK (gimp_display_shell_stylus_gesture_proximity),
+                    shell);
+  gtk_widget_add_controller (GTK_WIDGET (shell->canvas),
+                             GTK_EVENT_CONTROLLER (shell->stylus_gesture));
+
+  /* GtkEventControllerMotion */
+  shell->motion_controller = gtk_event_controller_motion_new ();
+  gtk_event_controller_set_propagation_phase (shell->motion_controller,
+                                              GTK_PHASE_BUBBLE);
+  g_signal_connect (shell->motion_controller, "enter",
+                    G_CALLBACK (gimp_display_shell_motion_controller_enter),
+                    shell);
+  g_signal_connect (shell->motion_controller, "leave",
+                    G_CALLBACK (gimp_display_shell_motion_controller_leave),
+                    shell);
+  g_signal_connect (shell->motion_controller, "motion",
+                    G_CALLBACK (gimp_display_shell_motion_controller_motion),
+                    shell);
+  gtk_widget_add_controller (GTK_WIDGET (shell->canvas),
+                             shell->motion_controller);
+
+  /* GtkEventControllerKey */
+  shell->key_controller = gtk_event_controller_key_new ();
+  gtk_event_controller_set_propagation_phase (shell->key_controller,
+                                              GTK_PHASE_CAPTURE);
+  g_signal_connect (shell->key_controller, "key-pressed",
+                    G_CALLBACK (gimp_display_shell_key_controller_key_pressed),
+                    shell);
+  g_signal_connect (shell->key_controller, "key-released",
+                    G_CALLBACK (gimp_display_shell_key_controller_key_released),
+                    shell);
+  g_signal_connect (shell->key_controller, "modifiers",
+                    G_CALLBACK (gimp_display_shell_key_controller_modifiers),
+                    shell);
+  gtk_widget_add_controller (GTK_WIDGET (shell->canvas),
+                             shell->key_controller);
+}
+
+void
+gimp_display_shell_click_gesture_pressed (GtkGestureClick  *gesture,
+                                          gint              n_press,
+                                          gdouble           x,
+                                          gdouble           y,
+                                          GimpDisplayShell *shell)
+{
+  guint button;
+
+  g_return_if_fail (GIMP_IS_DISPLAY_SHELL (shell));
+
+  button = gtk_gesture_single_get_current_button (GTK_GESTURE_SINGLE (gesture));
+
+  if (button == GDK_BUTTON_PRIMARY)
+    {
+      GimpCoords display_coords = GIMP_COORDS_DEFAULT_VALUES;
+      GimpCoords image_coords;
+      GdkModifierType state = 0;
+
+      display_coords.x = x;
+      display_coords.y = y;
+      gimp_display_shell_untransform_coords (shell, &display_coords, &image_coords);
+      gimp_display_shell_initialize_tool (shell, &image_coords, state);
+    }
+  else if (button == GDK_BUTTON_SECONDARY)
+    {
+      /* Context menu */
+      GimpCoords display_coords = GIMP_COORDS_DEFAULT_VALUES;
+      GimpCoords image_coords;
+
+      display_coords.x = x;
+      display_coords.y = y;
+      gimp_display_shell_untransform_coords (shell, &display_coords, &image_coords);
+      gimp_display_triggers_context_menu (gtk_gesture_get_last_event (GTK_GESTURE (gesture),
+                                                                      gtk_gesture_single_get_current_sequence (GTK_GESTURE_SINGLE (gesture))),
+                                          shell, gimp_display_get_gimp (shell->display),
+                                          &image_coords, TRUE);
+    }
+}
+
+void
+gimp_display_shell_click_gesture_released (GtkGestureClick  *gesture,
+                                           gint              n_press,
+                                           gdouble           x,
+                                           gdouble           y,
+                                           GimpDisplayShell *shell)
+{
+  g_return_if_fail (GIMP_IS_DISPLAY_SHELL (shell));
+}
+
+void
+gimp_display_shell_click_gesture_stopped (GtkGestureClick  *gesture,
+                                          GimpDisplayShell *shell)
+{
+  g_return_if_fail (GIMP_IS_DISPLAY_SHELL (shell));
+}
+
+void
+gimp_display_shell_drag_gesture_begin (GtkGestureDrag   *gesture,
+                                       gdouble           start_x,
+                                       gdouble           start_y,
+                                       GimpDisplayShell *shell)
+{
+  GimpCoords display_coords = GIMP_COORDS_DEFAULT_VALUES;
+  GimpCoords image_coords;
+
+  g_return_if_fail (GIMP_IS_DISPLAY_SHELL (shell));
+
+  display_coords.x = start_x;
+  display_coords.y = start_y;
+  gimp_display_shell_untransform_coords (shell, &display_coords, &image_coords);
+  gimp_display_shell_initialize_tool (shell, &image_coords, 0);
+}
+
+void
+gimp_display_shell_drag_gesture_update (GtkGestureDrag   *gesture,
+                                        gdouble           offset_x,
+                                        gdouble           offset_y,
+                                        GimpDisplayShell *shell)
+{
+  gdouble start_x, start_y;
+  GimpCoords display_coords = GIMP_COORDS_DEFAULT_VALUES;
+  GimpCoords image_coords;
+
+  g_return_if_fail (GIMP_IS_DISPLAY_SHELL (shell));
+
+  if (gtk_gesture_drag_get_start_point (gesture, &start_x, &start_y))
+    {
+      display_coords.x = start_x + offset_x;
+      display_coords.y = start_y + offset_y;
+      gimp_display_shell_untransform_coords (shell, &display_coords, &image_coords);
+      gimp_display_shell_buffer_stroke (shell->motion_buffer, &image_coords,
+                                        g_get_monotonic_time () / 1000, 0, shell);
+    }
+}
+
+void
+gimp_display_shell_drag_gesture_end (GtkGestureDrag   *gesture,
+                                     gdouble           offset_x,
+                                     gdouble           offset_y,
+                                     GimpDisplayShell *shell)
+{
+  g_return_if_fail (GIMP_IS_DISPLAY_SHELL (shell));
+}
+
+void
+gimp_display_shell_stylus_gesture_down (GtkGestureStylus *gesture,
+                                        gdouble           x,
+                                        gdouble           y,
+                                        GimpDisplayShell *shell)
+{
+  gdouble pressure = 1.0;
+  gdouble tilt_x = 0.0;
+  gdouble tilt_y = 0.0;
+  GimpCoords display_coords = GIMP_COORDS_DEFAULT_VALUES;
+  GimpCoords image_coords;
+
+  g_return_if_fail (GIMP_IS_DISPLAY_SHELL (shell));
+
+  gtk_gesture_stylus_get_axis (gesture, GDK_AXIS_PRESSURE, &pressure);
+  gtk_gesture_stylus_get_axis (gesture, GDK_AXIS_XTILT, &tilt_x);
+  gtk_gesture_stylus_get_axis (gesture, GDK_AXIS_YTILT, &tilt_y);
+
+  display_coords.x = x;
+  display_coords.y = y;
+  display_coords.pressure = CLAMP (pressure, 0.0, 1.0);
+  display_coords.xtilt = tilt_x;
+  display_coords.ytilt = tilt_y;
+
+  gimp_display_shell_untransform_coords (shell, &display_coords, &image_coords);
+  gimp_display_shell_initialize_tool (shell, &image_coords, 0);
+}
+
+void
+gimp_display_shell_stylus_gesture_motion (GtkGestureStylus *gesture,
+                                          gdouble           x,
+                                          gdouble           y,
+                                          GimpDisplayShell *shell)
+{
+  gdouble pressure = 1.0;
+  gdouble tilt_x = 0.0;
+  gdouble tilt_y = 0.0;
+  GimpCoords display_coords = GIMP_COORDS_DEFAULT_VALUES;
+  GimpCoords image_coords;
+
+  g_return_if_fail (GIMP_IS_DISPLAY_SHELL (shell));
+
+  gtk_gesture_stylus_get_axis (gesture, GDK_AXIS_PRESSURE, &pressure);
+  gtk_gesture_stylus_get_axis (gesture, GDK_AXIS_XTILT, &tilt_x);
+  gtk_gesture_stylus_get_axis (gesture, GDK_AXIS_YTILT, &tilt_y);
+
+  display_coords.x = x;
+  display_coords.y = y;
+  display_coords.pressure = CLAMP (pressure, 0.0, 1.0);
+  display_coords.xtilt = tilt_x;
+  display_coords.ytilt = tilt_y;
+
+  gimp_display_shell_untransform_coords (shell, &display_coords, &image_coords);
+  gimp_display_shell_buffer_stroke (shell->motion_buffer, &image_coords,
+                                    g_get_monotonic_time () / 1000, 0, shell);
+}
+
+void
+gimp_display_shell_stylus_gesture_up (GtkGestureStylus *gesture,
+                                      gdouble           x,
+                                      gdouble           y,
+                                      GimpDisplayShell *shell)
+{
+  g_return_if_fail (GIMP_IS_DISPLAY_SHELL (shell));
+}
