+static gboolean
+gimp_display_shell_kinetic_pan_tick (GtkWidget     *widget,
+                                     GdkFrameClock *frame_clock,
+                                     gpointer       user_data)
+{
+  GimpDisplayShell *shell = GIMP_DISPLAY_SHELL (user_data);
+  gint64            now = g_get_monotonic_time ();
+  gdouble           dt = (now - shell->kinetic_pan_last_time_us) / 1000000.0;
+  gdouble           dx, dy;
+
+  if (dt <= 0.0 || dt > 0.1)
+    dt = 1.0 / 60.0;
+
+  shell->kinetic_pan_last_time_us = now;
+
+  dx = shell->kinetic_pan_vel_x * dt;
+  dy = shell->kinetic_pan_vel_y * dt;
+
+  gimp_display_shell_scroll (shell, -RINT (dx), -RINT (dy));
+
+  /* Apply exponential decay friction */
+  shell->kinetic_pan_vel_x *= exp (-shell->kinetic_pan_friction * dt * 1000.0);
+  shell->kinetic_pan_vel_y *= exp (-shell->kinetic_pan_friction * dt * 1000.0);
+
+  if (hypot (shell->kinetic_pan_vel_x, shell->kinetic_pan_vel_y) < 5.0)
+    {
+      shell->kinetic_pan_tick_id = 0;
+      return G_SOURCE_REMOVE;
+    }
+
+  return G_SOURCE_CONTINUE;
+}
+
+gboolean
+gimp_display_shell_scroll_controller_scroll (GtkEventControllerScroll *controller,
+                                             gdouble                   dx,
+                                             gdouble                   dy,
+                                             GimpDisplayShell         *shell)
+{
+  GdkModifierType state = 0;
+  GdkEvent       *current_event;
+
+  current_event = gtk_get_current_event ();
+  if (current_event)
+    {
+      gdk_event_get_state (current_event, &state);
+      gdk_event_free (current_event);
+    }
+
+  if (state & gimp_get_toggle_behavior_mask ())
+    {
+      /* Ctrl + Scroll -> Smooth Zoom centered on pointer / midpoint */
+      gimp_display_shell_scale (shell,
+                                GIMP_ZOOM_SMOOTH,
+                                dy,
+                                GIMP_ZOOM_FOCUS_POINTER);
+    }
+  else
+    {
+      /* Smooth inertial pan along both axes */
+      gdouble h_val = gtk_adjustment_get_value (shell->hsbdata);
+      gdouble v_val = gtk_adjustment_get_value (shell->vsbdata);
+      gdouble h_step = gtk_adjustment_get_step_increment (shell->hsbdata);
+      gdouble v_step = gtk_adjustment_get_step_increment (shell->vsbdata);
+
+      gtk_adjustment_set_value (shell->hsbdata, h_val + dx * h_step);
+      gtk_adjustment_set_value (shell->vsbdata, v_val + dy * v_step);
+    }
+
+  return TRUE;
+}
+
+void
+gimp_display_shell_scroll_controller_scroll_begin (GtkEventControllerScroll *controller,
+                                                   GimpDisplayShell         *shell)
+{
+  if (shell->kinetic_pan_tick_id)
+    {
+      gtk_widget_remove_tick_callback (GTK_WIDGET (shell), shell->kinetic_pan_tick_id);
+      shell->kinetic_pan_tick_id = 0;
+    }
+}
+
+void
+gimp_display_shell_scroll_controller_scroll_end (GtkEventControllerScroll *controller,
+                                                 GimpDisplayShell         *shell)
+{
+  /* Gesture completed */
+}
+
+void
+gimp_display_shell_scroll_controller_decelerate (GtkEventControllerScroll *controller,
+                                                 gdouble                   initial_vel_x,
+                                                 gdouble                   initial_vel_y,
+                                                 GimpDisplayShell         *shell)
+{
+  if (shell->kinetic_pan_tick_id)
+    {
+      gtk_widget_remove_tick_callback (GTK_WIDGET (shell), shell->kinetic_pan_tick_id);
+      shell->kinetic_pan_tick_id = 0;
+    }
+
+  if (hypot (initial_vel_x, initial_vel_y) > 10.0)
+    {
+      shell->kinetic_pan_vel_x = initial_vel_x;
+      shell->kinetic_pan_vel_y = initial_vel_y;
+      shell->kinetic_pan_friction = 0.005;
+      shell->kinetic_pan_last_time_us = g_get_monotonic_time ();
+      shell->kinetic_pan_tick_id = gtk_widget_add_tick_callback (GTK_WIDGET (shell),
+                                                                 (GtkTickCallback) gimp_display_shell_kinetic_pan_tick,
+                                                                 shell,
+                                                                 NULL);
+    }
+}
