+GdkTexture *
+gimp_display_shell_render_get_texture (GimpDisplayShell *shell,
+                                       gint              x,
+                                       gint              y,
+                                       gint              width,
+                                       gint              height)
+{
+  GdkTexture *texture = NULL;
+
+  g_return_val_if_fail (GIMP_IS_DISPLAY_SHELL (shell), NULL);
+
+  if (shell->render_cache && width > 0 && height > 0)
+    {
+      guchar *data;
+      gint    stride;
+      gint    c_w;
+      gint    c_h;
+
+      cairo_surface_flush (shell->render_cache);
+      data   = cairo_image_surface_get_data (shell->render_cache);
+      stride = cairo_image_surface_get_stride (shell->render_cache);
+      c_w    = cairo_image_surface_get_width (shell->render_cache);
+      c_h    = cairo_image_surface_get_height (shell->render_cache);
+
+      if (data && c_w > 0 && c_h > 0)
+        {
+          GBytes *bytes = g_bytes_new_static (data, stride * c_h);
+          texture = gdk_memory_texture_new (c_w, c_h,
+                                            GDK_MEMORY_B8G8R8A8_PREMULTIPLIED,
+                                            bytes,
+                                            stride);
+          g_bytes_unref (bytes);
+        }
+    }
+
+  return texture;
+}
