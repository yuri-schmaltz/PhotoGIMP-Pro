+                ("ocio_acescg_convert", "output", "adj_curves_cmyk_tonal", "input"),
+                ("adj_curves_cmyk_tonal", "output", "lcms2_cmyk_proofing", "input"),
+                ("lcms2_cmyk_proofing", "output", "display_viewport", "input"),
