+                {"id": "fx_stroke", "operation": "gegl:stroke"},
+                {"id": "fx_drop_shadow", "operation": "gegl:drop-shadow"},
+                {"id": "lcms2_cmyk_proof", "operation": "gegl:lcms-proof"},
