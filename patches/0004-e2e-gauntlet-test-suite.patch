+            {"pressure": 0.5, "tilt_x": 12.5, "tilt_y": -5.0, "is_eraser": False},
+            {"pressure": 0.95, "tilt_x": 25.0, "tilt_y": -10.0, "is_eraser": False},
+            {"pressure": 0.4, "tilt_x": 0.0, "tilt_y": 0.0, "is_eraser": True},
+        ]
+
+        for s in stylus_samples:
