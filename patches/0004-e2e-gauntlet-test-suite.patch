+        t = target.strip().lower()
+        if not q:
+            return True, 0
+        if q == t:
+            return True, 1000  # Exact match
+        if q in t:
+            # Substring match: earlier index scores higher
+            idx = t.index(q)
+            return True, 500 - idx * 2
+
+        # Subsequence matching
+        q_idx = 0
+        score = 0
+        consecutive = 0
+        for i, ch in enumerate(t):
