+        xcf_path = self.assets.create_xcf("adjustment_test.xcf", width=200, height=200, version=14)
+        self.assertTrue(xcf_path.exists())
+        data = xcf_path.read_bytes()
+        self.assertTrue(data.startswith(b"gimp xcf v014"))
+
