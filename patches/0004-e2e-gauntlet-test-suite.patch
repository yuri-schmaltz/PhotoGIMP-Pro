+                q_idx += 1
+                consecutive += 1
+                score += 10 + consecutive * 5
+                # Bonus for word boundary
+                if i == 0 or t[i - 1] in " -_./":
+                    score += 20
+            else:
+                consecutive = 0
+
+        matched = (q_idx == len(q))
+        return matched, score if matched else 0
