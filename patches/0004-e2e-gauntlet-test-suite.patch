+    def test_f06_02_gimprc_theme_activation(self):
+        """Verifies gimprc profile settings configure Dark-Pro theme and Symbolic icons."""
+        gimprc_path = self.config_dir / "gimprc"
+        self.assertTrue(gimprc_path.exists())
