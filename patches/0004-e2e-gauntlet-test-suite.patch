+        active_shortcuts: List[Tuple[str, str]] = []
+        inactive_shortcuts: List[Tuple[str, str]] = []
+
+        active_pattern = re.compile(r'^\s*\(action\s+"([^"]+)"(?:\s+"([^"]+)")*\)')
+        inactive_pattern = re.compile(r'^\s*#\s*\(action\s+"([^"]+)"(?:\s+"([^"]+)")*\)')
