+void                  gimp_adjustment_layer_set_config     (GimpAdjustmentLayer *layer,
+                                                            GObject             *config,
+                                                            gboolean             push_undo);
+
+gboolean              gimp_adjustment_layer_get_clipped    (GimpAdjustmentLayer *layer);
+void                  gimp_adjustment_layer_set_clipped    (GimpAdjustmentLayer *layer,
+                                                            gboolean             clipped,
+                                                            gboolean             push_undo);
