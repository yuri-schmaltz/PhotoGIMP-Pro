.var/app/org.gimp.GIMP/.ld.so
.var/app/org.gimp.GIMP/data
.var/app/org.gimp.GIMP/current
.vscode/*
.devcontainer
__pycache__/
*.pyc
*.pyo
*.exe
*.dll
*.so
*.so.*
*.dylib
*.bin
*.msi
*.dmg
*.pkg
*.deb
*.rpm
*.AppImage
*.app
*.jar
*.class
*.wasm
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.tar.bz2
*.tbz2
*.tar.xz
*.txz
dist/
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
